print("\n--- ADVANCED SIMULATION: MULTIPLE FAULTS HANDLING ---")

def simulate_multi_fault_flisr(graph, fault_edges, available_ties):
    """
    Simulates a severe grid event with multiple simultaneous faults.
    The algorithm attempts to reroute power using multiple tie lines dynamically.
    """
    print(f"\n[MULTI-FAULT EVENT] Critical faults detected at branches: {fault_edges}")
    G_healed = graph.copy()
    
    # 1. Fault Isolation: Disconnect all damaged branches
    for u, v in fault_edges:
        if G_healed.has_edge(u, v):
            G_healed.remove_edge(u, v)
            print(f"[ISOLATION] Branch {(u, v)} successfully disconnected.")
        elif G_healed.has_edge(v, u): # Handle undirected edge reverse case
            G_healed.remove_edge(v, u)
            print(f"[ISOLATION] Branch {(v, u)} successfully disconnected.")
    
    # 2. Assess Initial Connectivity
    powered_from_main = nx.node_connected_component(G_healed, 1)
    all_nodes = set(G_healed.nodes())
    blackout_nodes = all_nodes - powered_from_main
    
    if not blackout_nodes:
        return G_healed, []
        
    print(f"[ANALYSIS] Initial unpowered nodes identified: {sorted(list(blackout_nodes))}")
    
    # 3. Dynamic Self-Healing (Multi-Rerouting via Tie Lines)
    activated_ties = []
    for u, v in available_ties:
        current_powered = nx.node_connected_component(G_healed, 1)
        current_blackout = all_nodes - current_powered
        
        if not current_blackout:
            break  # Break loop if all nodes are successfully restored
            
        # If the tie line connects a powered zone to a blackout zone, close the switch
        if (u in current_powered and v in current_blackout) or (v in current_powered and u in current_blackout):
            activated_ties.append((u, v))
            G_healed.add_edge(u, v, state='healed', type='tie')
            print(f"[RESTORATION] Optimal tie line identified and closed: {(u, v)}")

    # 4. Final Verification
    final_powered = nx.node_connected_component(G_healed, 1)
    final_blackout = all_nodes - final_powered
    
    if not final_blackout:
        print("[STATUS] 100% Load restored via multi-path grid routing.")
    else:
        print(f"[STATUS] Restoration incomplete. Nodes {sorted(list(final_blackout))} remain isolated.")
            
    return G_healed, activated_ties


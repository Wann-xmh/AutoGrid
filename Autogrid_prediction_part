# 2.2 FLISR Algorithm implementation
def simulate_flisr_reconfiguration(graph, fault_edge, available_ties):
    print(f"[EVENT] Fault detected at branch: {fault_edge}")
    G_healed = graph.copy()
    
    # Fault Isolation
    if G_healed.has_edge(*fault_edge):
        G_healed.remove_edge(*fault_edge)
        print(f"[ISOLATION] Branch {fault_edge} successfully disconnected.")
    
    # Assess Connectivity
    powered_from_main = nx.node_connected_component(G_healed, 1)
    all_nodes = set(G_healed.nodes())
    blackout_nodes = all_nodes - powered_from_main
    
    if not blackout_nodes:
        return G_healed, None
        
    print(f"[ANALYSIS] Unpowered nodes identified: {sorted(list(blackout_nodes))}")
    
    # Self-Healing (Rerouting)
    activated_tie = None
    for u, v in available_ties:
        if (u in powered_from_main and v in blackout_nodes) or (v in powered_from_main and u in blackout_nodes):
            activated_tie = (u, v)
            G_healed.add_edge(u, v, state='healed', type='tie')
            print(f"[RESTORATION] Optimal tie line identified and closed: {activated_tie}")
            
            # Verify restoration
            new_powered = nx.node_connected_component(G_healed, 1)
            remaining_blackout = all_nodes - new_powered
            
            if not remaining_blackout:
                print("[STATUS] 100% Load restored via primary grid routing.")
            else:
                islanding_sources = [n for n in remaining_blackout if n in battery_nodes or n in pv_nodes]
                if islanding_sources:
                    print(f"[ISLANDING] Nodes {sorted(list(remaining_blackout))} operating in Islanding Mode utilizing DERs at {islanding_sources}.")
            break
            
    if not activated_tie:
        print("[CRITICAL] Grid reconfiguration failed. No suitable tie line available.")
        
    return G_healed, activated_tie


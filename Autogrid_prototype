<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AutoGrid — AI-Powered Grid Dual-Engine Prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
  :root{
    --void:#0a0c10;
    --panel:#12151c;
    --panel-2:#161a22;
    --line:#242a34;
    --text:#e8eaed;
    --text-dim:#8b95a5;
    --text-faint:#5a6472;
    --fault:#e4483b;
    --restore:#34d399;
    --amber:#f5a623;
    --battery:#4fa8e0;
    --ev:#b084f5;
    --supply:#ffffff;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--void);
    color:var(--text);
    font-family:'IBM Plex Sans',sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}

  /* ---------- background circuit texture ---------- */
  .grain{
    position:fixed;inset:0;pointer-events:none;z-index:1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:64px 64px;
    opacity:.12;
  }

  /* ---------- nav ---------- */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:20px 40px;
    background:rgba(10,12,16,.7);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px;letter-spacing:.02em;}
  .logo .dot{width:9px;height:9px;border-radius:50%;background:var(--restore);box-shadow:0 0 12px var(--restore);animation:pulse 2s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
  .navlinks{display:flex;gap:32px;font-size:13px;color:var(--text-dim);letter-spacing:.04em;text-transform:uppercase;}
  .navlinks a{text-decoration:none;transition:color .2s;}
  .navlinks a:hover{color:var(--restore);}
  @media(max-width:780px){.navlinks{display:none;}}

  /* ---------- hero ---------- */
  .hero{
    min-height:100vh;
    display:flex;flex-direction:column;justify-content:center;
    padding:140px 40px 60px;
    position:relative;
    max-width:1200px;margin:0 auto;
  }
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--restore);margin-bottom:22px;
    display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:'';width:24px;height:1px;background:var(--restore);}
  .hero h1{
    font-size:clamp(38px,6vw,74px);
    line-height:1.02;
    font-weight:700;
    letter-spacing:-.02em;
    max-width:900px;
  }
  .hero h1 .accent{color:var(--restore);}
  .hero p{
    margin-top:26px;max-width:640px;font-size:17px;line-height:1.65;color:var(--text-dim);
  }
  .hero-actions{margin-top:38px;display:flex;gap:16px;flex-wrap:wrap;}
  .btn{
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;letter-spacing:.04em;
    padding:14px 26px;border-radius:2px;
    border:1px solid var(--line);
    background:transparent;color:var(--text);
    cursor:pointer;transition:all .2s;
    text-decoration:none;display:inline-flex;align-items:center;gap:8px;
  }
  .btn:hover{border-color:var(--restore);color:var(--restore);}
  .btn.primary{background:var(--restore);color:#06110d;border-color:var(--restore);font-weight:600;}
  .btn.primary:hover{background:#5eead4;color:#06110d;}

  .ticker{
    margin-top:56px;padding-top:26px;border-top:1px solid var(--line);
    display:flex;gap:48px;flex-wrap:wrap;
  }
  .ticker .stat .num{font-family:'Space Grotesk',sans-serif;font-size:28px;font-weight:600;}
  .ticker .stat .lbl{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;margin-top:4px;}

  /* ---------- section shell ---------- */
  section{position:relative;z-index:2;padding:100px 40px;max-width:1200px;margin:0 auto;}
  .section-head{margin-bottom:48px;max-width:680px;}
  .section-head .eyebrow{margin-bottom:14px;}
  .section-head h2{font-size:clamp(26px,3.4vw,38px);font-weight:600;letter-spacing:-.01em;}
  .section-head p{margin-top:14px;color:var(--text-dim);font-size:15px;line-height:1.6;}

  /* ---------- demo panel ---------- */
  .demo-shell{
    border:1px solid var(--line);background:var(--panel);border-radius:4px;overflow:hidden;
  }
  .demo-top{display:grid;grid-template-columns:1fr 340px;min-height:560px;}
  @media(max-width:920px){.demo-top{grid-template-columns:1fr;}}
  #cityCanvas{width:100%;height:100%;display:block;background:radial-gradient(circle at 50% 30%, #10141b 0%, #090b0f 70%);}
  .canvas-wrap{position:relative;min-height:420px;}
  .canvas-hint{
    position:absolute;bottom:14px;left:14px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;
    color:var(--text-faint);letter-spacing:.03em;pointer-events:none;
  }
  .legend{
    position:absolute;top:14px;left:14px;display:flex;flex-direction:column;gap:6px;
    font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--text-dim);
    background:rgba(10,12,16,.55);padding:10px 12px;border:1px solid var(--line);border-radius:3px;
  }
  .legend .row{display:flex;align-items:center;gap:8px;}
  .legend .sw{width:9px;height:9px;border-radius:2px;flex-shrink:0;}

  .side-panel{
    border-left:1px solid var(--line);display:flex;flex-direction:column;
  }
  .side-panel .block{padding:20px 22px;border-bottom:1px solid var(--line);}
  .side-panel .block:last-child{border-bottom:none;flex:1;}
  .side-panel h4{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-faint);margin-bottom:12px;}

  .gauge-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;}
  .gauge-row .val{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;}
  .gauge-track{height:6px;background:#1c2029;border-radius:3px;overflow:hidden;margin-bottom:14px;}
  .gauge-fill{height:100%;border-radius:3px;transition:width .6s ease;}

  .rca-bar{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--text-dim);margin-bottom:8px;}
  .rca-bar .label{width:56px;flex-shrink:0;font-family:'IBM Plex Mono',monospace;}
  .rca-bar .track{flex:1;height:5px;background:#1c2029;border-radius:3px;overflow:hidden;}
  .rca-bar .fill{height:100%;border-radius:3px;transition:width .6s ease;}
  .rca-bar .pct{width:34px;text-align:right;font-family:'IBM Plex Mono',monospace;}

  .eq-line{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--text-dim);margin-bottom:4px;}
  .eq-line .v{color:var(--restore);}

  .strategy-box{
    font-family:'IBM Plex Mono',monospace;font-size:11.5px;line-height:1.6;padding:12px;
    background:#0c0e13;border:1px solid var(--line);border-radius:3px;color:var(--text-dim);min-height:52px;
  }
  .strategy-box.active{border-color:var(--amber);color:var(--amber);}

  .console{
    font-family:'IBM Plex Mono',monospace;font-size:10.5px;line-height:1.7;color:var(--text-faint);
    overflow-y:auto;max-height:150px;
  }
  .console .l{white-space:pre-wrap;}
  .console .l.new{color:var(--restore);}
  .console .l.warn{color:var(--fault);}

  .demo-controls{
    display:flex;gap:1px;background:var(--line);border-top:1px solid var(--line);
  }
  .ctrl-btn{
    flex:1;background:var(--panel);border:none;color:var(--text);padding:18px 14px;
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.03em;cursor:pointer;
    display:flex;flex-direction:column;align-items:flex-start;gap:3px;transition:background .2s;
  }
  .ctrl-btn:hover:not(:disabled){background:var(--panel-2);}
  .ctrl-btn:disabled{opacity:.35;cursor:not-allowed;}
  .ctrl-btn .step{color:var(--text-faint);font-size:10px;}
  .ctrl-btn.step1{border-top:2px solid var(--amber);}
  .ctrl-btn.step2{border-top:2px solid var(--fault);}
  .ctrl-btn.step3{border-top:2px solid var(--restore);}
  .ctrl-btn.reset{border-top:2px solid var(--text-faint);max-width:150px;flex:0 0 150px;}

  .selected-chips{
    position:absolute;bottom:14px;right:14px;display:flex;flex-wrap:wrap;gap:6px;max-width:60%;justify-content:flex-end;
  }
  .chip{
    font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--fault);
    background:rgba(228,72,59,.12);border:1px solid var(--fault);border-radius:20px;
    padding:4px 10px;display:flex;align-items:center;gap:6px;
  }
  .chip button{background:none;border:none;color:var(--fault);cursor:pointer;font-family:inherit;font-size:11px;padding:0;line-height:1;}

  /* ---------- solution modal ---------- */
  .modal-backdrop{
    display:none;position:fixed;inset:0;z-index:100;background:rgba(6,7,10,.78);backdrop-filter:blur(4px);
    align-items:center;justify-content:center;padding:24px;
  }
  .modal-backdrop.open{display:flex;}
  .modal{
    width:100%;max-width:640px;max-height:82vh;overflow-y:auto;
    background:var(--panel);border:1px solid var(--line);border-radius:6px;
    box-shadow:0 30px 80px rgba(0,0,0,.6);
  }
  .modal-head{
    display:flex;justify-content:space-between;align-items:center;
    padding:20px 26px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--panel);
  }
  .modal-head h3{font-size:18px;}
  .modal-close{background:none;border:1px solid var(--line);color:var(--text-dim);font-family:'IBM Plex Mono',monospace;font-size:11px;padding:7px 12px;border-radius:2px;cursor:pointer;}
  .modal-close:hover{border-color:var(--fault);color:var(--fault);}
  .modal-body{padding:24px 26px;}
  .solution-card{
    border:1px solid var(--line);border-radius:4px;padding:16px 18px;margin-bottom:14px;background:#0c0e13;
  }
  .solution-card .sc-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  .solution-card .sc-head .bus{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:15px;}
  .solution-card .sc-head .tag{
    font-family:'IBM Plex Mono',monospace;font-size:10.5px;padding:3px 9px;border-radius:20px;letter-spacing:.03em;
  }
  .tag.restored{background:rgba(52,211,153,.14);color:var(--restore);border:1px solid var(--restore);}
  .tag.islanded{background:rgba(245,166,35,.14);color:var(--amber);border:1px solid var(--amber);}
  .tag.dark{background:rgba(228,72,59,.14);color:var(--fault);border:1px solid var(--fault);}
  .solution-card .sc-row{font-size:12.5px;color:var(--text-dim);line-height:1.7;}
  .solution-card .sc-row b{color:var(--text);font-weight:500;}
  .modal-summary{
    display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:20px;
  }
  .modal-summary div{background:var(--panel-2);padding:14px 16px;}
  .modal-summary .num{font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:600;}
  .modal-summary .lbl{font-size:10.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;}
  .violation-list{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--fault);line-height:1.8;}

  /* ---------- methodology cards ---------- */
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  @media(max-width:860px){.cards{grid-template-columns:1fr;}}
  .card{background:var(--panel);padding:30px 26px;}
  .card .idx{font-family:'IBM Plex Mono',monospace;color:var(--text-faint);font-size:12px;margin-bottom:16px;}
  .card h3{font-size:18px;margin-bottom:10px;}
  .card p{font-size:13.5px;color:var(--text-dim);line-height:1.65;margin-bottom:14px;}
  .card .eq{font-family:'IBM Plex Mono',monospace;font-size:12.5px;background:#0c0e13;border:1px solid var(--line);padding:12px;border-radius:3px;color:var(--restore);}

  /* ---------- case study ---------- */
  .case-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:start;}
  @media(max-width:860px){.case-grid{grid-template-columns:1fr;gap:32px;}}
  .case-grid p{color:var(--text-dim);font-size:15px;line-height:1.75;margin-bottom:16px;}
  .case-stats{display:flex;flex-direction:column;gap:0;border:1px solid var(--line);}
  .case-stat{padding:22px 24px;border-bottom:1px solid var(--line);}
  .case-stat:last-child{border-bottom:none;}
  .case-stat .num{font-family:'Space Grotesk',sans-serif;font-size:32px;font-weight:600;color:var(--fault);}
  .case-stat .num.good{color:var(--restore);}
  .case-stat .lbl{font-size:12px;color:var(--text-faint);margin-top:6px;letter-spacing:.02em;}

  /* ---------- matrix table ---------- */
  table.matrix{width:100%;border-collapse:collapse;border:1px solid var(--line);font-size:13.5px;}
  table.matrix th{
    text-align:left;padding:14px 18px;background:var(--panel-2);color:var(--text-faint);
    font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.06em;
    border-bottom:1px solid var(--line);
  }
  table.matrix td{padding:16px 18px;border-bottom:1px solid var(--line);color:var(--text-dim);vertical-align:top;}
  table.matrix tr:last-child td{border-bottom:none;}
  table.matrix td.cause{color:var(--text);font-weight:500;}

  /* ---------- code section ---------- */
  .code-shell{
    border:1px solid var(--line);background:var(--panel);border-radius:4px;
    display:grid;grid-template-columns:1fr auto;gap:20px;padding:34px 36px;align-items:center;
  }
  @media(max-width:700px){.code-shell{grid-template-columns:1fr;}}
  .code-shell h3{font-size:20px;margin-bottom:8px;}
  .code-shell p{color:var(--text-dim);font-size:14px;line-height:1.6;max-width:520px;}
  .repo-path{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--restore);margin-top:10px;display:block;}

  footer{
    border-top:1px solid var(--line);padding:44px 40px;max-width:1200px;margin:0 auto;
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;
    font-size:12.5px;color:var(--text-faint);
  }
  footer .authors{line-height:1.8;}
</style>
</head>

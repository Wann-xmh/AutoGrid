  const hits = raycaster.intersectObjects(buildingMeshes);
  if(hits.length===0) return;
  const busId = hits[0].object.userData.busId;
  if(busId===1) { log('bus 1 is the main substation — it cannot be marked as faulted.', 'warn'); return; }

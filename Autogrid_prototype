}
treeEdges.forEach(([a,b])=>{
  lineObjs[edgeKey(a,b)] = makeLine(a,b,0x3a4150,false);
});
tieEdges.forEach(([a,b])=>{
  lineObjs[edgeKey(a,b)] = makeLine(a,b,0x2a3038,true);
});

/* ---------- orbit-style manual controls + click-to-select ---------- */
let dragging=false, lastX=0, lastY=0, downX=0, downY=0;
canvas.addEventListener('pointerdown', e=>{dragging=true; lastX=e.clientX; lastY=e.clientY; downX=e.clientX; downY=e.clientY;});
window.addEventListener('pointerup', e=>{

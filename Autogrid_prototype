  } else {
    selectionSummary.innerHTML = '<b style="color:var(--fault)">'+faultedNodes.size+' bus'+(faultedNodes.size>1?'es':'')+'</b> marked as faulted:<br>'+[...faultedNodes].sort((a,b)=>a-b).map(n=>'Bus '+n+' — branch '+(parentOf[n]||'?')+'–'+n+' will be opened by protection').join('<br>');
  }
  btnHeal.disabled = faultedNodes.size===0;
}

/* ---------- core self-healing solver ---------- */
function findComponent(startList, adj){
  const seen = new Set(); const comps = [];
  startList.forEach(n=>{
    if(seen.has(n)) return;
    const comp=[]; const q=[n]; seen.add(n);
    while(q.length){ const cur=q.shift(); comp.push(cur); (adj[cur]||[]).forEach(nb=>{ if(!seen.has(nb)){seen.add(nb); q.push(nb);} }); }
    comps.push(comp);
  });
  return comps;
}

function runSelfHeal(){
  healed = true;
  const remainingNodes = allNodeIds.filter(n=>!faultedNodes.has(n));
  log('self-healing engine: BFS reconfiguration search initiated…');
  [...faultedNodes].sort((a,b)=>a-b).forEach(n=>{
    log('FAULT: equipment failure at bus '+n+' — protection opens branch '+parentOf[n]+'–'+n, 'warn');
    setLine(parentOf[n], n, 0xe4483b, true);
  });

  // graph with faulted nodes (and their edges) removed
  const adj = {};
  treeEdges.forEach(([a,b])=>{
    if(faultedNodes.has(a)||faultedNodes.has(b)) return;
    (adj[a]=adj[a]||[]).push(b); (adj[b]=adj[b]||[]).push(a);
  });
  const comps = findComponent(remainingNodes, adj);
  const energizedComp = comps.find(c=>c.includes(1));
  const originalEnergized = new Set(energizedComp);
  let energizedSet = new Set(energizedComp);
  const islands = comps.filter(c=>c!==energizedComp);
  const activatedTies = [];

  let changed = true;
  while(changed){
    changed = false;
    for(const [a,b] of tieEdges){
      if(faultedNodes.has(a)||faultedNodes.has(b)) continue;
      const key = edgeKey(a,b);
      if(activatedTies.includes(key)) continue;
      const aIn = energizedSet.has(a), bIn = energizedSet.has(b);
      if(aIn && !bIn){
        const isl = islands.find(c=>c.includes(b) && !c.every(x=>energizedSet.has(x)));
        if(isl){ isl.forEach(x=>energizedSet.add(x)); activatedTies.push(key); changed=true; log('tie-switch '+a+'–'+b+' CLOSED — bridges bus '+b+'\'s zone back to the main feeder', 'new'); }
      } else if(bIn && !aIn){
        const isl = islands.find(c=>c.includes(a) && !c.every(x=>energizedSet.has(x)));
        if(isl){ isl.forEach(x=>energizedSet.add(x)); activatedTies.push(key); changed=true; log('tie-switch '+a+'–'+b+' CLOSED — bridges bus '+a+'\'s zone back to the main feeder', 'new'); }
      }
    }
  }
  activatedTies.forEach(k=>{ const [a,b]=k.split('-').map(Number); setLine(a,b,0x34d399,true); });
  tieEdges.forEach(([a,b])=>{ if(!activatedTies.includes(edgeKey(a,b))) setLine(a,b,0x2a3038,true); });

  const remainingIslands = islands.filter(c=>!c.every(x=>energizedSet.has(x)));
  const islandStatus = []; // {nodes, status:'islanded'|'dark', derNode}
  remainingIslands.forEach(c=>{
    const derNode = c.find(n=>derMap[n]);
    islandStatus.push({nodes:c, status: derNode ? 'islanded' : 'dark', derNode});
  });

  // paint result
  allNodeIds.forEach(n=>{
    if(faultedNodes.has(n)) return; // already painted red
    if(originalEnergized.has(n)){
      setBuildingState(n, nodeMeshes[n].base, derMap[n] ? 0.85 : 0.32); // untouched by the fault
    } else if(energizedSet.has(n)){
      setBuildingState(n, 0x34d399, 0.65); // restored via tie
    }
  });
  islandStatus.forEach(({nodes,status})=>{
    nodes.forEach(n=>{
      if(faultedNodes.has(n)) return;
      setBuildingState(n, status==='islanded' ? 0xf5a623 : 0x1c2029, status==='islanded' ? 0.9 : 0.05);
    });
  });

  const restoredCount = [...energizedSet].filter(n=>!originalEnergized.has(n)).length;
  const islandedCount = islandStatus.filter(s=>s.status==='islanded').reduce((s,i)=>s+i.nodes.length,0);
  const darkCount = islandStatus.filter(s=>s.status==='dark').reduce((s,i)=>s+i.nodes.length,0);
  log(restoredCount+' buses restored via tie-line reroute.', 'new');
  if(islandedCount) log(islandedCount+' buses sustained in DER islanding mode.', 'new');
  if(darkCount) log(darkCount+' buses remain de-energized — no viable restoration path.', 'warn');

  // compliance check on the final energized (grid-connected) network only
  const finalAdj = {};
  treeEdges.forEach(([a,b])=>{
    if(faultedNodes.has(a)||faultedNodes.has(b)) return;
    if(!energizedSet.has(a) || !energizedSet.has(b)) return;
    (finalAdj[a]=finalAdj[a]||[]).push(b); (finalAdj[b]=finalAdj[b]||[]).push(a);
  });
  activatedTies.forEach(k=>{
    const [a,b] = k.split('-').map(Number);
    (finalAdj[a]=finalAdj[a]||[]).push(b); (finalAdj[b]=finalAdj[b]||[]).push(a);
  });
  const flow = computeFlow(finalAdj, 1);
  const voltViolations = [];
  const currViolations = [];
  flow.order.forEach(n=>{
    const v = flow.voltage[n];
    if(v<VMIN || v>VMAX) voltViolations.push({n, v});
  });
  Object.keys(flow.currents).forEach(key=>{
    const I = flow.currents[key];
    const rating = branchRating[key] || 200;
    if(I > rating) currViolations.push({key, I, rating});
  });
  const voltOk = flow.order.length - voltViolations.length;
  const currOk = Object.keys(flow.currents).length - currViolations.length;
  document.getElementById('voltCompliance').textContent = voltOk+'/'+flow.order.length;
  document.getElementById('voltFill').style.width = (100*voltOk/flow.order.length).toFixed(0)+'%';
  document.getElementById('voltFill').style.background = voltViolations.length ? 'var(--fault)' : 'var(--restore)';
  const totalBranches = Object.keys(flow.currents).length;
  document.getElementById('currCompliance').textContent = currOk+'/'+totalBranches;
  document.getElementById('currFill').style.width = (100*currOk/totalBranches).toFixed(0)+'%';
  document.getElementById('currFill').style.background = currViolations.length ? 'var(--fault)' : 'var(--restore)';
  if(voltViolations.length) log(voltViolations.length+' bus(es) outside the 0.95–1.05 pu voltage band.', 'warn');
  if(currViolations.length) log(currViolations.length+' branch(es) exceed their thermal current rating.', 'warn');
  if(!voltViolations.length && !currViolations.length) log('all restored branches within voltage and current limits (Eq. 5).', 'new');

  showSolutionsModal({islandStatus, activatedTies, restoredCount, darkCount, voltViolations, currViolations, flow});
  btnHeal.disabled = true;
}

function rcaFor(n){
  // deterministic pseudo-RCA seeded by bus id, in the spirit of Eq. 6–8
  const seed = (n*2654435761) % 1000 / 1000;
  const Ctemp = 0.3 + seed*0.5, Cload = 0.25 + ((seed*7)%1)*0.4, Cage = 0.2 + ((seed*13)%1)*0.6;
  const sum = Ctemp+Cload+Cage;
  const r = {temp:Ctemp/sum, load:Cload/sum, age:Cage/sum};
  const dominant = r.temp>=r.load && r.temp>=r.age ? 'thermal stress' : (r.load>=r.age ? 'grid load' : 'equipment aging');
  return {r, dominant};
}

function showSolutionsModal({islandStatus, activatedTies, restoredCount, darkCount, voltViolations, currViolations}){
  let html = '';
  html += '<div class="modal-summary">';
  html += '<div><div class="num" style="color:var(--fault)">'+faultedNodes.size+'</div><div class="lbl">Faulted buses</div></div>';
  html += '<div><div class="num" style="color:var(--restore)">'+restoredCount+'</div><div class="lbl">Restored via tie-line</div></div>';
  html += '</div>';

  html += '<h4 style="font-size:13px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;">Per-Bus Diagnosis</h4>';
  [...faultedNodes].sort((a,b)=>a-b).forEach(n=>{
    const {dominant} = rcaFor(n);
    html += '<div class="solution-card"><div class="sc-head"><span class="bus">Bus '+n+'</span><span class="tag dark">EQUIPMENT FAULT</span></div>';
    html += '<div class="sc-row"><b>Diagnosed cause:</b> '+dominant+' (Eq. 6–8 root-cause decomposition).</div>';
    html += '<div class="sc-row"><b>Isolation:</b> protection opens branch '+parentOf[n]+'–'+n+'; bus '+n+' itself stays de-energized until the faulted equipment is repaired — it cannot be bypassed.</div></div>';
  });

  html += '<h4 style="font-size:13px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin:18px 0 10px;">Downstream Restoration</h4>';
  if(activatedTies.length===0 && islandStatus.length===0){
    html += '<div class="solution-card"><div class="sc-row">No downstream buses were isolated — the fault only affected the selected bus(es) directly.</div></div>';
  }
  activatedTies.forEach(k=>{
    const [a,b] = k.split('-').map(Number);
    html += '<div class="solution-card"><div class="sc-head"><span class="bus">Tie '+a+'–'+b+'</span><span class="tag restored">RESTORED</span></div><div class="sc-row">Normally-open tie-switch closed by the BFS reconfiguration search, rerouting power from the main feeder around the fault.</div></div>';
  });
  islandStatus.forEach(({nodes,status,derNode})=>{
    if(status==='islanded'){
      html += '<div class="solution-card"><div class="sc-head"><span class="bus">Buses '+nodes.filter(n=>!faultedNodes.has(n)).join(', ')+'</span><span class="tag islanded">ISLANDED</span></div><div class="sc-row">No tie-line path back to the main feeder was available. Bus '+derNode+'\'s local DER ('+derMap[derNode]+') sustains critical loads in islanding mode (Table I, row 3).</div></div>';
    } else {
      html += '<div class="solution-card"><div class="sc-head"><span class="bus">Buses '+nodes.filter(n=>!faultedNodes.has(n)).join(', ')+'</span><span class="tag dark">DE-ENERGIZED</span></div><div class="sc-row">No tie-line path and no local DER available. These buses remain dark until a repair crew clears the fault.</div></div>';
    }
  });

  html += '<h4 style="font-size:13px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin:18px 0 10px;">Electrical Constraint Check (Eq. 5)</h4>';
  if(voltViolations.length===0 && currViolations.length===0){
    html += '<div class="solution-card"><div class="sc-row" style="color:var(--restore)">All restored branches and buses stay within the 0.95–1.05 pu voltage band and their thermal current ratings. Reconfiguration is electrically feasible as-is.</div></div>';
  } else {
    html += '<div class="solution-card"><div class="violation-list">';
    voltViolations.forEach(v=>{ html += 'Bus '+v.n+': '+v.v.toFixed(3)+' pu — outside 0.95–1.05 pu<br>'; });
    currViolations.forEach(v=>{ html += 'Branch '+v.key+': '+v.I.toFixed(0)+' A — exceeds rated '+v.rating.toFixed(0)+' A<br>'; });
    html += '</div><div class="sc-row" style="margin-top:8px;">The optimizer (Eq. 4) would need to shed lower-priority load or select an alternate tie to bring these back within limits.</div></div>';
  }

  modalBody.innerHTML = html;
  modalBackdrop.classList.add('open');
}

document.getElementById('modalClose').addEventListener('click', ()=> modalBackdrop.classList.remove('open'));
modalBackdrop.addEventListener('click', e=>{ if(e.target===modalBackdrop) modalBackdrop.classList.remove('open'); });

btnHeal.addEventListener('click', runSelfHeal);

btnCuba.addEventListener('click', ()=>{
  if(healed) repaintIdle();
  faultedNodes = new Set([15,26]);
  refreshSelectionVisuals();
  log('loaded Cuba-style scenario: simultaneous equipment faults at bus 15 and bus 26 (paper Fig. 4–6).');
});

function repaintIdle(){
  healed = false;
  allNodeIds.forEach(n=>{
    const o = nodeMeshes[n];
    setBuildingState(n, o.base, derMap[n] ? 0.85 : (n===1?0.5:0.32));
  });
  treeEdges.forEach(([a,b])=> setLine(a,b, 0x3a4150, true));
  tieEdges.forEach(([a,b])=> setLine(a,b, 0x2a3038, true));
  document.getElementById('voltCompliance').textContent = '33/33';
  document.getElementById('voltFill').style.width='100%';
  document.getElementById('voltFill').style.background='var(--restore)';
  document.getElementById('currCompliance').textContent = '32/32';
  document.getElementById('currFill').style.width='100%';
  document.getElementById('currFill').style.background='var(--restore)';
}

btnClear.addEventListener('click', ()=>{
  faultedNodes = new Set();
  repaintIdle();
  refreshSelectionVisuals();
  log('fault selection cleared.');
});

btnReset.addEventListener('click', ()=>{
  faultedNodes = new Set();
  repaintIdle();
  refreshSelectionVisuals();
  modalBackdrop.classList.remove('open');
  consoleEl.innerHTML = '<div class="l">&gt; system idle. all 33 buses nominal.</div>';
});

// initial paint
repaintIdle();
refreshSelectionVisuals();
</script>

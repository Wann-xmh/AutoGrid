updateCamera();

const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));

const ambient = new THREE.AmbientLight(0x8899bb, 0.55);
scene.add(ambient);
const key = new THREE.DirectionalLight(0xffffff, 0.5);
key.position.set(80,140,60);
scene.add(key);

// ground grid
const grid = new THREE.GridHelper(700, 70, 0x1c2230, 0x151a22);
grid.position.y = -0.2;
scene.add(grid);
const groundMat = new THREE.MeshBasicMaterial({color:0x0b0d12});
const ground = new THREE.Mesh(new THREE.PlaneGeometry(900,900), groundMat);
ground.rotation.x = -Math.PI/2; ground.position.y = -0.5;
scene.add(ground);

// building meshes per node
const nodeMeshes = {};
const heightSeed = {};
Object.keys(positions).forEach(k=>{ heightSeed[k] = 6 + (parseInt(k)*37 % 22); });

function baseColor(n){
  if(n==1) return 0xffffff;
  if(derMap[n]) return derColor[derMap[n]];
  return 0x5b6472;
}

const selectionRings = {};
Object.entries(positions).forEach(([n,p])=>{
  const h = heightSeed[n];

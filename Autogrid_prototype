// power lines
const lineObjs = {};
function makeLine(a,b,color,dashed){
  const pa = positions[a], pb = positions[b];
  const geo = new THREE.BufferGeometry().setFromPoints([
    new THREE.Vector3(pa.x, 1, pa.z),

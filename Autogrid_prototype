function resize(){
  const w = canvas.clientWidth, h = canvas.clientHeight;
  renderer.setSize(w,h,false);
  camera.aspect = w/h;
  camera.updateProjectionMatrix();
}
new ResizeObserver(resize).observe(canvas);

let spin = true;
function animate(){
  requestAnimationFrame(animate);
  if(spin && !dragging){ camTheta += 0.0007; updateCamera(); }
  renderer.render(scene, camera);
}
resize();
animate();

/* =========================================================
   LOAD FLOW HELPERS (simplified linearized DistFlow, for the
   compliance panel — Eq. 5 current limit + ANSI voltage band)
   ========================================================= */
function bfsTree(adj, root){
  const parent={}; const order=[root]; const visited=new Set([root]); const queue=[root];
  while(queue.length){
    const cur = queue.shift();
    (adj[cur]||[]).forEach(nb=>{ if(!visited.has(nb)){ visited.add(nb); parent[nb]=cur; order.push(nb); queue.push(nb); } });
  }
  return {parent, order};
}
function computeFlow(adj, root){
  const {parent, order} = bfsTree(adj, root);
  const childrenOf = {};
  order.forEach(n=>{ if(parent[n]!==undefined) (childrenOf[parent[n]]=childrenOf[parent[n]]||[]).push(n); });
  const downP={}, downQ={};
  for(let i=order.length-1;i>=0;i--){
    const n = order[i];
    let p = loadData[n][0], q = loadData[n][1];
    (childrenOf[n]||[]).forEach(c=>{ p+=downP[c]; q+=downQ[c]; });
    downP[n]=p; downQ[n]=q;
  }
  const currents={};
  order.forEach(n=>{
    if(parent[n]===undefined) return;
    const S = Math.sqrt(downP[n]**2+downQ[n]**2); // kVA
    currents[edgeKey(parent[n],n)] = S/(Math.sqrt(3)*Vbase); // Amps
  });
  const voltage={}; voltage[root]=1.0;
  order.forEach(n=>{
    if(parent[n]===undefined) return;
    const p = parent[n];
    const rx = branchRX[edgeKey(p,n)] || {r:0.5,x:0.5};
    const dV = ((downP[n]/1000)*rx.r + (downQ[n]/1000)*rx.x) / (Vbase*Vbase);
    voltage[n] = voltage[p] - dV;
  });
  return {downP, downQ, currents, voltage, parent, order};
}
// baseline (no-fault) currents → used to derive an illustrative thermal rating per branch
const baselineAdj = {};
treeEdges.forEach(([a,b])=>{ (baselineAdj[a]=baselineAdj[a]||[]).push(b); (baselineAdj[b]=baselineAdj[b]||[]).push(a); });
const baselineFlow = computeFlow(baselineAdj, 1);
const branchRating = {};
treeEdges.forEach(([a,b])=>{
  const key = edgeKey(a,b);
  branchRating[key] = Math.max(40, baselineFlow.currents[key]*1.25);
});
tieEdges.forEach(([a,b])=>{ branchRating[edgeKey(a,b)] = 150; });


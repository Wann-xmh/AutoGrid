const btnCuba = document.getElementById('btnCuba');
const btnHeal = document.getElementById('btnHeal');
const btnClear = document.getElementById('btnClear');
const btnReset = document.getElementById('btnReset');
const selectedChips = document.getElementById('selectedChips');
const selectionSummary = document.getElementById('selectionSummary');
const modalBackdrop = document.getElementById('modalBackdrop');
const modalBody = document.getElementById('modalBody');

let faultedNodes = new Set();
let healed = false;

function toggleFault(n){
  if(healed) repaintIdle(); // selecting again after a heal starts a fresh scenario
  if(faultedNodes.has(n)) faultedNodes.delete(n); else faultedNodes.add(n);

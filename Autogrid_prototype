}

function refreshSelectionVisuals(){
  Object.entries(selectionRings).forEach(([n,ring])=>{ ring.visible = faultedNodes.has(parseInt(n)); });
  Object.keys(nodeMeshes).forEach(n=>{
    n = parseInt(n); if(n===1) return;
    const o = nodeMeshes[n];
    if(faultedNodes.has(n)) setBuildingState(n, 0xe4483b, 0.9);
    else setBuildingState(n, o.base, derMap[n] ? 0.85 : 0.32);
  });
  selectedChips.innerHTML = '';
  [...faultedNodes].sort((a,b)=>a-b).forEach(n=>{
    const chip = document.createElement('div');

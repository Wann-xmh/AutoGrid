  mesh.userData.busId = parseInt(n);
  scene.add(mesh);
  nodeMeshes[n] = {mesh, mat, h, base: baseColor(n)};

  // selection ring — shown when a bus is marked as faulted
  const ring = new THREE.Mesh(
    new THREE.TorusGeometry(w*0.95, 0.35, 8, 24),
    new THREE.MeshBasicMaterial({color:0xe4483b})
  );
  ring.rotation.x = Math.PI/2;
  ring.position.set(p.x, 0.4, p.z);
  ring.visible = false;
  scene.add(ring);
  selectionRings[n] = ring;

  // DER marker (small glowing sphere on roof)
  if(derMap[n]){
    const s = new THREE.Mesh(new THREE.SphereGeometry(1.4,12,12), new THREE.MeshBasicMaterial({color:derColor[derMap[n]]}));
    s.position.set(p.x, h+2.4, p.z);
